    "demo:setup": "node scripts/setup-demo.mjs",
    "solver:dev": "powershell -File scripts/solver-dev.ps1",
    "benchmark": "solver/.venv/Scripts/python solver/benchmark.py",
    "benchmark:verify": "tsx scripts/verify-benchmark.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@vercel/oidc": "4.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "workflow": "5.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
